modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
integrations = [
  "javascript_openai_ai_integrations:2.0.0",
  "javascript_log_in_with_replit:2.0.0",
]

[nix]
channel = "stable-25_05"
packages = ["sqlite"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Website"

[[workflows.workflow]]
name = "Website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd website && npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "gce"
run = ["bash", "-c", "cd website && node server.js & cd discordbot && node bot.js"]
build = ["sh", "-c", "bash -lc set -e; (cd website && npm install); (cd discordbot && npm install)"]
publicDir = "static-test"
ignorePorts = true

[userenv]

[userenv.shared]
DISCORD_APP_ID = "1399412635878822010"
DISCORD_PUBLIC_KEY = "3c9f1f4347b788fca44caef06c35ffdf61c91f245baf5c94c65fe527b67786ae"
