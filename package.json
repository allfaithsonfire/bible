{
  "name": "allfaithsonfire",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prod-all": "pm2 start ecosystem.config.js && pm2 save",
    "dev-discord": "cd discordbot && npm run dev",
    "dev-website": "cd website && npm run dev",
    "install-all": "npm install --prefix discordbot && npm install --prefix website",
    "dev-all": "concurrently -n discordbot,website -c cyan,magenta \"npm run dev-discord\" \"npm run dev-website\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^5.3.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "drizzle-zod": "^0.8.3",
    "openai": "^6.15.0",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "pg": "^8.16.3",
    "zod": "^4.2.1",
    "zod-validation-error": "^5.0.0"
  }
}
