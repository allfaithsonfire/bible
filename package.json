{
  "name": "allfaithsonfire",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prod-all": "pm2 start ecosystem.config.js && pm2 save",
    "dev-discord": "cd discordbot && npm run dev",
    "dev-website": "cd website && npm run dev",
    "install-all": "npm install --prefix discordbot && npm install --prefix website",
    "dev-all": "concurrently -n discordbot,website -c cyan,magenta \"npm run dev-discord\" \"npm run dev-website\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^5.3.0"
  },
  "dependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.18.2",
    "@types/memoizee": "^0.4.12",
    "@types/passport": "^1.0.17",
    "better-sqlite3": "^12.5.0",
    "connect-pg-simple": "^10.0.0",
    "drizzle-zod": "^0.8.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "memoizee": "^0.4.17",
    "openai": "^6.15.0",
    "openid-client": "^6.8.1",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "passport": "^0.7.0",
    "passport-discord-auth": "^1.2.0",
    "pg": "^8.16.3",
    "zod": "^4.2.1",
    "zod-validation-error": "^5.0.0"
  }
