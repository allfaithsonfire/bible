<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Submit Scripture - All Faiths On Fire</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      font-family: sans-serif;
      min-height: 100%;
    }
    header, footer {
      background: #222;
      color: #fff;
      padding: 1rem;
      text-align: center;
    }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    .header-main {
      text-align: center;
      flex: 1;
    }
    .header-auth {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .auth-btn {
      background: #fff;
      color: #222;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9rem;
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
    }
    main {
      max-width: 800px;
      margin: 2rem auto;
      padding: 0 1rem;
    }
    h2 {
      color: #333;
      border-bottom: 2px solid #e74c3c;
      padding-bottom: 0.5rem;
    }
    .intro {
      background: #f9f9f9;
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 2rem;
      line-height: 1.6;
    }
    .form-group {
      margin-bottom: 1.5rem;
    }
    label {
      display: block;
      font-weight: bold;
      margin-bottom: 0.5rem;
      color: #333;
    }
    .label-hint {
      font-weight: normal;
      color: #666;
      font-size: 0.9rem;
    }
    input[type="text"], select, textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 1rem;
      font-family: inherit;
    }
    textarea {
      min-height: 200px;
      line-height: 1.6;
    }
    .submit-btn {
      background: #e74c3c;
      color: #fff;
      border: none;
      padding: 1rem 2rem;
      font-size: 1.1rem;
      border-radius: 4px;
      cursor: pointer;
    }
    .submit-btn:hover {
      background: #c0392b;
    }
    .login-prompt {
      text-align: center;
      padding: 3rem;
      background: #f9f9f9;
      border-radius: 8px;
    }
    .login-prompt a {
      display: inline-block;
      background: #e74c3c;
      color: #fff;
      padding: 1rem 2rem;
      text-decoration: none;
      border-radius: 4px;
      margin-top: 1rem;
    }
    .success-message {
      background: #27ae60;
      color: #fff;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }
    .back-link {
      display: inline-block;
      margin-bottom: 1rem;
      color: #666;
      text-decoration: none;
    }
    .back-link:hover {
      color: #333;
    }
    footer {
      margin-top: 3rem;
      padding: 0.5rem;
      font-size: 0.9em;
    }
  </style>
  <link rel="stylesheet" href="/css/themes.css">
</head>
<body>
  <header>
    <div class="header-content">
      <div style="width:150px;"></div>
      <div class="header-main">
        <h1 style="margin:0;">All Faiths On Fire</h1>
      </div>
      <div class="header-auth">
        <% if (user) { %>
          <div class="user-info">
            <% if (user.profileImage) { %>
              <img src="<%= user.profileImage %>" alt="" class="user-avatar">
            <% } %>
            <span style="font-size:0.9rem;"><%= user.firstName || user.email || 'Seeker' %></span>
          </div>
          <a href="/api/logout" class="auth-btn">Sign Out</a>
        <% } else { %>
          <a href="/api/login" class="auth-btn">Join Us</a>
        <% } %>
      </div>
    </div>
  </header>

  <main>
    <a href="/" class="back-link">← Back to Scripture</a>
    
    <h2>Submit Your Words</h2>
    
    <% if (!user) { %>
      <div class="login-prompt">
        <h3>Join Our Community of Writers</h3>
        <p>To contribute to the living scripture, please sign in first.</p>
        <a href="/api/login">Join Us</a>
      </div>
    <% } else { %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message">
          Your submission has been received! Our community will review it with care.
        </div>
      <% } %>

      <div class="intro">
        <p><strong>Welcome, <%= user.firstName || 'Seeker' %>.</strong></p>
        <p>This is where the Book grows. Share your verses, your chapters, your wisdom. Every contribution is reviewed by our community before it becomes part of the living scripture.</p>
        <p>Write from the heart. The fire recognizes its own.</p>
      </div>

      <form action="/submit" method="POST">
        <div class="form-group">
          <label>What are you submitting?</label>
          <select name="submission_type" required>
            <option value="">Choose...</option>
            <option value="verse">A Single Verse</option>
            <option value="chapter">A Chapter (multiple verses)</option>
            <option value="book">A New Book (collection of chapters)</option>
            <option value="quote">A Wisdom Quote</option>
            <option value="edit">An Edit to Existing Scripture</option>
          </select>
        </div>

        <div class="form-group">
          <label>Book Title <span class="label-hint">(existing or new)</span></label>
          <input type="text" name="book_title" placeholder="e.g., Book of Prophets, The Book of Dawn...">
        </div>

        <div class="form-group">
          <label>Chapter Title <span class="label-hint">(if applicable)</span></label>
          <input type="text" name="chapter_title" placeholder="e.g., The First Light, The Gathering...">
        </div>

        <div class="form-group">
          <label>Your Contribution</label>
          <textarea name="content" required placeholder="Write your verse, chapter, or wisdom here...

For multiple verses, number them like:
1. First verse text here.
2. Second verse text here.

Let your words flow naturally. The formatting will be handled with care."></textarea>
        </div>

        <div class="form-group">
          <label>Notes for Reviewers <span class="label-hint">(optional)</span></label>
          <textarea name="notes" style="min-height:80px;" placeholder="Any context, inspiration, or notes about your submission..."></textarea>
        </div>

        <button type="submit" class="submit-btn">Submit for Review</button>
      </form>
    <% } %>
  </main>

  <footer>
    &copy; All Faiths On Fire - <%= new Date().getFullYear() %>
  </footer>
</body>
</html>
