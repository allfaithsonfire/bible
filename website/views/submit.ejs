<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>Submit Scripture - All Faiths On Fire</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Georgia', 'Times New Roman', serif;
      min-height: 100%;
      background: #faf8f5;
      color: #2c2416;
    }
    header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: #f0e6d3;
      padding: 1.25rem 1rem;
      text-align: center;
      border-bottom: 3px solid #c9a227;
    }
    header h1 {
      font-size: 1.75rem;
      letter-spacing: 0.02em;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    }
    footer {
      background: #1a1a2e;
      color: #a09080;
      padding: 0.75rem;
      font-size: 0.85em;
      text-align: center;
      margin-top: 3rem;
    }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    .header-main {
      text-align: center;
      flex: 1;
    }
    .header-auth {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .auth-btn {
      background: #c9a227;
      color: #1a1a2e;
      border: none;
      padding: 0.5rem 1.25rem;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .auth-btn:hover {
      background: #e0b830;
      transform: translateY(-1px);
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid #c9a227;
    }
    .user-name {
      font-size: 0.9rem;
      color: #f0e6d3;
    }
    main {
      max-width: 800px;
      margin: 2rem auto;
      padding: 0 1.5rem;
    }
    h2 {
      color: #3d3425;
      border-bottom: 2px solid #c9a227;
      padding-bottom: 0.5rem;
    }
    .intro {
      background: linear-gradient(180deg, #f5f0e8 0%, #ebe4d8 100%);
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 2rem;
      line-height: 1.7;
      border: 1px solid #d4c9b8;
    }
    .form-group {
      margin-bottom: 1.5rem;
    }
    label {
      display: block;
      font-weight: bold;
      margin-bottom: 0.5rem;
      color: #3d3425;
    }
    .label-hint {
      font-weight: normal;
      color: #8b7355;
      font-size: 0.9rem;
    }
    input[type="text"], select, textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #d4c9b8;
      border-radius: 4px;
      font-size: 1rem;
      font-family: inherit;
      background: #fdfcfa;
    }
    input[type="text"]:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #c9a227;
      box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.2);
    }
    textarea {
      min-height: 200px;
      line-height: 1.7;
    }
    .submit-btn {
      background: #c9a227;
      color: #1a1a2e;
      border: none;
      padding: 1rem 2rem;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .submit-btn:hover {
      background: #e0b830;
      transform: translateY(-1px);
    }
    .login-prompt {
      text-align: center;
      padding: 3rem;
      background: linear-gradient(180deg, #f5f0e8 0%, #ebe4d8 100%);
      border-radius: 8px;
      border: 1px solid #d4c9b8;
    }
    .login-prompt h3 {
      color: #3d3425;
    }
    .login-prompt p {
      color: #5a4d3a;
      line-height: 1.7;
    }
    .login-prompt a.discord-btn {
      display: inline-block;
      background: #5865F2;
      color: #fff;
      padding: 1rem 2rem;
      text-decoration: none;
      border-radius: 4px;
      margin-top: 1rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .login-prompt a.discord-btn:hover {
      background: #4752c4;
      transform: translateY(-1px);
    }
    .success-message {
      background: #27ae60;
      color: #fff;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }
    .back-link {
      display: inline-block;
      margin-bottom: 1rem;
      color: #8b7355;
      text-decoration: none;
      transition: color 0.15s;
    }
    .back-link:hover {
      color: #c9a227;
    }
    .autocomplete-wrapper {
      position: relative;
    }
    .autocomplete-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fdfcfa;
      border: 1px solid #c9a227;
      border-top: none;
      border-radius: 0 0 4px 4px;
      max-height: 200px;
      overflow-y: auto;
      z-index: 100;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      display: none;
    }
    .autocomplete-dropdown.show {
      display: block;
    }
    .autocomplete-item {
      padding: 0.75rem;
      cursor: pointer;
      border-bottom: 1px solid #e8e0d4;
      transition: background 0.15s;
    }
    .autocomplete-item:last-child {
      border-bottom: none;
    }
    .autocomplete-item:hover, .autocomplete-item.active {
      background: linear-gradient(180deg, #f5f0e8 0%, #ebe4d8 100%);
    }
    .autocomplete-item .book-hint {
      font-size: 0.85rem;
      color: #8b7355;
      font-style: italic;
    }
    .input-wrapper {
      display: none;
    }
    .input-wrapper.active {
      display: block;
    }
  </style>
  <link rel="stylesheet" href="/css/themes.css">
</head>
<body>
  <header>
    <div class="header-content">
      <div style="width:150px;"></div>
      <div class="header-main">
        <h1 style="margin:0;">All Faiths On Fire</h1>
      </div>
      <div class="header-auth">
        <% if (user) { %>
          <div class="user-info">
            <% if (user.profileImage) { %>
              <img src="<%= user.profileImage %>" alt="" class="user-avatar">
            <% } %>
            <span class="user-name"><%= user.firstName || user.email || 'Seeker' %></span>
          </div>
          <a href="/api/logout" class="auth-btn">Sign Out</a>
        <% } else { %>
          <a href="https://discord.gg/4kypdCMsC5" target="_blank" class="auth-btn" style="background:#5865F2;color:#fff;">Join Us on Discord</a>
        <% } %>
      </div>
    </div>
  </header>

  <main>
    <a href="/" class="back-link">← Back to Scripture</a>
    
    <h2>Submit Your Words</h2>
    
    <% if (!user) { %>
      <div class="login-prompt">
        <h3>Join Our Community of Writers</h3>
        <p>The heart of All Faiths On Fire beats on Discord. That's where we gather, where we write together, where the fire burns brightest.</p>
        <a href="https://discord.gg/4kypdCMsC5" target="_blank" class="discord-btn">Join Us on Discord</a>
        <p style="margin-top:1.5rem;font-size:0.9rem;">Already a member? <a href="/api/login" style="color:#c9a227;">Sign in here</a> to submit through the website.</p>
      </div>
    <% } else { %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message">
          Your submission has been received! Our community will review it with care.
        </div>
      <% } %>

      <div class="intro">
        <p><strong>Welcome, <%= user.firstName || 'Seeker' %>.</strong></p>
        <p>This is where the Book grows. Share your verses, your chapters, your wisdom. Every contribution is reviewed by our community before it becomes part of the living scripture.</p>
        <p>Write from the heart. The fire recognizes its own.</p>
      </div>

      <form action="/submit" method="POST">
        <div class="form-group">
          <label>What are you submitting?</label>
          <select name="submission_type" required>
            <option value="">Choose...</option>
            <option value="verse">A Single Verse</option>
            <option value="chapter">A Chapter (multiple verses)</option>
            <option value="book">A New Book (collection of chapters)</option>
            <option value="quote">A Wisdom Quote</option>
            <option value="edit">An Edit to Existing Scripture</option>
          </select>
        </div>

        <div class="form-group" id="book-field-group">
          <label>Book Title <span class="label-hint" id="book-hint">(existing or new)</span></label>
          <input type="hidden" name="book_id" id="book_id">
          <div class="input-wrapper active" id="book-text-wrapper">
            <div class="autocomplete-wrapper">
              <input type="text" name="book_title" id="book_title" placeholder="e.g., Book of Prophets, The Book of Dawn..." autocomplete="off">
              <div class="autocomplete-dropdown" id="book-dropdown"></div>
            </div>
          </div>
          <div class="input-wrapper" id="book-select-wrapper">
            <select name="book_title_select" id="book_title_select">
              <option value="">Select a book...</option>
            </select>
          </div>
        </div>

        <div class="form-group" id="chapter-field-group">
          <label>Chapter Title <span class="label-hint" id="chapter-hint">(if applicable)</span></label>
          <input type="hidden" name="chapter_id" id="chapter_id">
          <div class="input-wrapper active" id="chapter-text-wrapper">
            <div class="autocomplete-wrapper">
              <input type="text" name="chapter_title" id="chapter_title" placeholder="e.g., The First Light, The Gathering..." autocomplete="off">
              <div class="autocomplete-dropdown" id="chapter-dropdown"></div>
            </div>
          </div>
          <div class="input-wrapper" id="chapter-select-wrapper">
            <select name="chapter_title_select" id="chapter_title_select">
              <option value="">Select a chapter...</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Your Contribution</label>
          <textarea name="content" required placeholder="Write your verse, chapter, or wisdom here...

For multiple verses, number them like:
1. First verse text here.
2. Second verse text here.

Let your words flow naturally. The formatting will be handled with care."></textarea>
        </div>

        <div class="form-group">
          <label>Notes for Reviewers <span class="label-hint">(optional)</span></label>
          <textarea name="notes" style="min-height:80px;" placeholder="Any context, inspiration, or notes about your submission..."></textarea>
        </div>

        <button type="submit" class="submit-btn">Submit for Review</button>
      </form>
    <% } %>
  </main>

  <footer>
    &copy; All Faiths On Fire - <%= new Date().getFullYear() %>
  </footer>

  <% if (user) { %>
  <script>
  (function() {
    const submissionType = document.querySelector('select[name="submission_type"]');
    const bookTextWrapper = document.getElementById('book-text-wrapper');
    const bookSelectWrapper = document.getElementById('book-select-wrapper');
    const chapterTextWrapper = document.getElementById('chapter-text-wrapper');
    const chapterSelectWrapper = document.getElementById('chapter-select-wrapper');
    const bookInput = document.getElementById('book_title');
    const bookSelect = document.getElementById('book_title_select');
    const chapterInput = document.getElementById('chapter_title');
    const chapterSelect = document.getElementById('chapter_title_select');
    const bookIdField = document.getElementById('book_id');
    const chapterIdField = document.getElementById('chapter_id');
    const bookDropdown = document.getElementById('book-dropdown');
    const chapterDropdown = document.getElementById('chapter-dropdown');
    const bookHint = document.getElementById('book-hint');
    const chapterHint = document.getElementById('chapter-hint');

    let selectedBookId = null;
    let debounceTimer = null;

    function debounce(fn, delay) {
      return function(...args) {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => fn.apply(this, args), delay);
      };
    }

    function toggleMode(isEdit) {
      if (isEdit) {
        bookTextWrapper.classList.remove('active');
        bookSelectWrapper.classList.add('active');
        chapterTextWrapper.classList.remove('active');
        chapterSelectWrapper.classList.add('active');
        bookHint.textContent = '(select existing)';
        chapterHint.textContent = '(select existing)';
        loadBooksDropdown();
      } else {
        bookTextWrapper.classList.add('active');
        bookSelectWrapper.classList.remove('active');
        chapterTextWrapper.classList.add('active');
        chapterSelectWrapper.classList.remove('active');
        bookHint.textContent = '(existing or new)';
        chapterHint.textContent = '(if applicable)';
      }
    }

    async function loadBooksDropdown() {
      try {
        const res = await fetch('/api/books/search');
        const books = await res.json();
        bookSelect.innerHTML = '<option value="">Select a book...</option>';
        books.forEach(book => {
          const opt = document.createElement('option');
          opt.value = book.title;
          opt.dataset.id = book.id;
          opt.textContent = book.title;
          bookSelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Failed to load books:', e);
      }
    }

    async function loadChaptersDropdown(bookId) {
      try {
        const url = bookId ? `/api/chapters/search?bookId=${bookId}` : '/api/chapters/search';
        const res = await fetch(url);
        const chapters = await res.json();
        chapterSelect.innerHTML = '<option value="">Select a chapter...</option>';
        chapters.forEach(ch => {
          const opt = document.createElement('option');
          opt.value = ch.title;
          opt.dataset.id = ch.id;
          opt.textContent = ch.title + (ch.book_title ? ` (${ch.book_title})` : '');
          chapterSelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Failed to load chapters:', e);
      }
    }

    async function fetchSuggestions(type, query, bookId) {
      let url;
      if (type === 'book') {
        url = `/api/books/search?q=${encodeURIComponent(query)}`;
      } else {
        url = `/api/chapters/search?q=${encodeURIComponent(query)}`;
        if (bookId) url += `&bookId=${bookId}`;
      }
      const res = await fetch(url);
      return res.json();
    }

    function showSuggestions(dropdown, items, type) {
      dropdown.innerHTML = '';
      if (items.length === 0) {
        dropdown.classList.remove('show');
        return;
      }
      items.forEach(item => {
        const div = document.createElement('div');
        div.className = 'autocomplete-item';
        div.dataset.id = item.id;
        div.dataset.title = item.title;
        if (type === 'chapter' && item.book_title) {
          div.innerHTML = `${item.title} <span class="book-hint">(${item.book_title})</span>`;
        } else {
          div.textContent = item.title;
        }
        dropdown.appendChild(div);
      });
      dropdown.classList.add('show');
    }

    function hideDropdowns() {
      bookDropdown.classList.remove('show');
      chapterDropdown.classList.remove('show');
    }

    const handleBookInput = debounce(async function() {
      const query = bookInput.value.trim();
      if (query.length < 1) {
        hideDropdowns();
        return;
      }
      try {
        const items = await fetchSuggestions('book', query);
        showSuggestions(bookDropdown, items, 'book');
      } catch (e) {
        console.error('Book search error:', e);
      }
    }, 300);

    const handleChapterInput = debounce(async function() {
      const query = chapterInput.value.trim();
      if (query.length < 1) {
        hideDropdowns();
        return;
      }
      try {
        const items = await fetchSuggestions('chapter', query, selectedBookId);
        showSuggestions(chapterDropdown, items, 'chapter');
      } catch (e) {
        console.error('Chapter search error:', e);
      }
    }, 300);

    bookInput.addEventListener('input', handleBookInput);
    chapterInput.addEventListener('input', handleChapterInput);

    bookDropdown.addEventListener('click', function(e) {
      const item = e.target.closest('.autocomplete-item');
      if (item) {
        bookInput.value = item.dataset.title;
        bookIdField.value = item.dataset.id;
        selectedBookId = item.dataset.id;
        hideDropdowns();
      }
    });

    chapterDropdown.addEventListener('click', function(e) {
      const item = e.target.closest('.autocomplete-item');
      if (item) {
        chapterInput.value = item.dataset.title;
        chapterIdField.value = item.dataset.id;
        hideDropdowns();
      }
    });

    bookSelect.addEventListener('change', function() {
      const selectedOption = bookSelect.options[bookSelect.selectedIndex];
      bookIdField.value = selectedOption.dataset.id || '';
      selectedBookId = selectedOption.dataset.id || null;
      loadChaptersDropdown(selectedBookId);
    });

    chapterSelect.addEventListener('change', function() {
      const selectedOption = chapterSelect.options[chapterSelect.selectedIndex];
      chapterIdField.value = selectedOption.dataset.id || '';
    });

    submissionType.addEventListener('change', function() {
      const isEdit = this.value === 'edit';
      toggleMode(isEdit);
      bookIdField.value = '';
      chapterIdField.value = '';
      selectedBookId = null;
      bookInput.value = '';
      chapterInput.value = '';
      bookSelect.value = '';
      chapterSelect.innerHTML = '<option value="">Select a chapter...</option>';
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.autocomplete-wrapper')) {
        hideDropdowns();
      }
    });

    bookInput.addEventListener('focus', function() {
      if (bookInput.value.trim().length > 0) {
        handleBookInput();
      }
    });

    chapterInput.addEventListener('focus', function() {
      if (chapterInput.value.trim().length > 0) {
        handleChapterInput();
      }
    });
  })();
  </script>
  <% } %>
</body>
</html>
