<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>Submit Scripture - All Faiths On Fire</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Georgia', 'Times New Roman', serif;
      min-height: 100%;
      background: #faf8f5;
      color: #2c2416;
    }
    header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: #f0e6d3;
      padding: 1.25rem 1rem;
      text-align: center;
      border-bottom: 3px solid #c9a227;
    }
    header h1 {
      font-size: 1.75rem;
      letter-spacing: 0.02em;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    }
    footer {
      background: #1a1a2e;
      color: #a09080;
      padding: 0.75rem;
      font-size: 0.85em;
      text-align: center;
      margin-top: 3rem;
    }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    .header-main {
      text-align: center;
      flex: 1;
    }
    .header-auth {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .auth-btn {
      background: #c9a227;
      color: #1a1a2e;
      border: none;
      padding: 0.5rem 1.25rem;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .auth-btn:hover {
      background: #e0b830;
      transform: translateY(-1px);
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid #c9a227;
    }
    .user-name {
      font-size: 0.9rem;
      color: #f0e6d3;
    }
    main {
      max-width: 800px;
      margin: 2rem auto;
      padding: 0 1.5rem;
    }
    h2 {
      color: #3d3425;
      border-bottom: 2px solid #c9a227;
      padding-bottom: 0.5rem;
    }
    .intro {
      background: linear-gradient(180deg, #f5f0e8 0%, #ebe4d8 100%);
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 2rem;
      line-height: 1.7;
      border: 1px solid #d4c9b8;
    }
    .form-group {
      margin-bottom: 1.5rem;
    }
    label {
      display: block;
      font-weight: bold;
      margin-bottom: 0.5rem;
      color: #3d3425;
    }
    .label-hint {
      font-weight: normal;
      color: #8b7355;
      font-size: 0.9rem;
    }
    input[type="text"], select, textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #d4c9b8;
      border-radius: 4px;
      font-size: 1rem;
      font-family: inherit;
      background: #fdfcfa;
    }
    input[type="text"]:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #c9a227;
      box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.2);
    }
    textarea {
      min-height: 200px;
      line-height: 1.7;
    }
    .submit-btn {
      background: #c9a227;
      color: #1a1a2e;
      border: none;
      padding: 1rem 2rem;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .submit-btn:hover {
      background: #e0b830;
      transform: translateY(-1px);
    }
    .login-prompt {
      text-align: center;
      padding: 3rem;
      background: linear-gradient(180deg, #f5f0e8 0%, #ebe4d8 100%);
      border-radius: 8px;
      border: 1px solid #d4c9b8;
    }
    .login-prompt h3 {
      color: #3d3425;
    }
    .login-prompt p {
      color: #5a4d3a;
      line-height: 1.7;
    }
    .login-prompt a.discord-btn {
      display: inline-block;
      background: #5865F2;
      color: #fff;
      padding: 1rem 2rem;
      text-decoration: none;
      border-radius: 4px;
      margin-top: 1rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .login-prompt a.discord-btn:hover {
      background: #4752c4;
      transform: translateY(-1px);
    }
    .success-message {
      background: #27ae60;
      color: #fff;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }
    .back-link {
      display: inline-block;
      margin-bottom: 1rem;
      color: #8b7355;
      text-decoration: none;
      transition: color 0.15s;
    }
    .back-link:hover {
      color: #c9a227;
    }
  </style>
  <link rel="stylesheet" href="/css/themes.css">
</head>
<body>
  <header>
    <div class="header-content">
      <div style="width:150px;"></div>
      <div class="header-main">
        <h1 style="margin:0;">All Faiths On Fire</h1>
      </div>
      <div class="header-auth">
        <% if (user) { %>
          <div class="user-info">
            <% if (user.profileImage) { %>
              <img src="<%= user.profileImage %>" alt="" class="user-avatar">
            <% } %>
            <span class="user-name"><%= user.firstName || user.email || 'Seeker' %></span>
          </div>
          <a href="/api/logout" class="auth-btn">Sign Out</a>
        <% } else { %>
          <a href="https://discord.gg/4kypdCMsC5" target="_blank" class="auth-btn" style="background:#5865F2;color:#fff;">Join Us on Discord</a>
        <% } %>
      </div>
    </div>
  </header>

  <main>
    <a href="/" class="back-link">← Back to Scripture</a>
    
    <h2>Submit Your Words</h2>
    
    <% if (!user) { %>
      <div class="login-prompt">
        <h3>Join Our Community of Writers</h3>
        <p>The heart of All Faiths On Fire beats on Discord. That's where we gather, where we write together, where the fire burns brightest.</p>
        <a href="https://discord.gg/4kypdCMsC5" target="_blank" class="discord-btn">Join Us on Discord</a>
        <p style="margin-top:1.5rem;font-size:0.9rem;">Already a member? <a href="/api/login" style="color:#c9a227;">Sign in here</a> to submit through the website.</p>
      </div>
    <% } else { %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message">
          Your submission has been received! Our community will review it with care.
        </div>
      <% } %>

      <div class="intro">
        <p><strong>Welcome, <%= user.firstName || 'Seeker' %>.</strong></p>
        <p>This is where the Book grows. Share your verses, your chapters, your wisdom. Every contribution is reviewed by our community before it becomes part of the living scripture.</p>
        <p>Write from the heart. The fire recognizes its own.</p>
      </div>

      <form action="/submit" method="POST">
        <div class="form-group">
          <label>What are you submitting?</label>
          <select name="submission_type" required>
            <option value="">Choose...</option>
            <option value="verse">A Single Verse</option>
            <option value="chapter">A Chapter (multiple verses)</option>
            <option value="book">A New Book (collection of chapters)</option>
            <option value="quote">A Wisdom Quote</option>
            <option value="edit">An Edit to Existing Scripture</option>
          </select>
        </div>

        <div class="form-group">
          <label>Book Title <span class="label-hint">(existing or new)</span></label>
          <input type="text" name="book_title" placeholder="e.g., Book of Prophets, The Book of Dawn...">
        </div>

        <div class="form-group">
          <label>Chapter Title <span class="label-hint">(if applicable)</span></label>
          <input type="text" name="chapter_title" placeholder="e.g., The First Light, The Gathering...">
        </div>

        <div class="form-group">
          <label>Your Contribution</label>
          <textarea name="content" required placeholder="Write your verse, chapter, or wisdom here...

For multiple verses, number them like:
1. First verse text here.
2. Second verse text here.

Let your words flow naturally. The formatting will be handled with care."></textarea>
        </div>

        <div class="form-group">
          <label>Notes for Reviewers <span class="label-hint">(optional)</span></label>
          <textarea name="notes" style="min-height:80px;" placeholder="Any context, inspiration, or notes about your submission..."></textarea>
        </div>

        <button type="submit" class="submit-btn">Submit for Review</button>
      </form>
    <% } %>
  </main>

  <footer>
    &copy; All Faiths On Fire - <%= new Date().getFullYear() %>
  </footer>
</body>
</html>
