<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>All Faiths On Fire</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Georgia', 'Times New Roman', serif;
      height: 100%;
      overflow: hidden;
      background: #faf8f5;
      color: #2c2416;
    }
    header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: #f0e6d3;
      padding: 1.25rem 1rem;
      text-align: center;
      border-bottom: 3px solid #c9a227;
    }
    header h1 {
      font-size: 1.75rem;
      letter-spacing: 0.02em;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    }
    header em {
      color: #d4c4a8;
      font-size: 0.95rem;
    }
    footer {
      background: #1a1a2e;
      color: #a09080;
      padding: 0.75rem;
      font-size: 0.85em;
      text-align: center;
    }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    .header-main {
      text-align: center;
      flex: 1;
    }
    .header-auth {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .auth-btn {
      background: #c9a227;
      color: #1a1a2e;
      border: none;
      padding: 0.5rem 1.25rem;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .auth-btn:hover {
      background: #e0b830;
      transform: translateY(-1px);
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid #c9a227;
    }
    .user-name {
      font-size: 0.9rem;
      color: #f0e6d3;
    }
    .layout {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .main {
      display: flex;
      flex: 1;
      min-height: 0;
    }
    nav.toc, aside.right {
      min-width: 240px;
      width: 260px;
      background: linear-gradient(180deg, #f5f0e8 0%, #ebe4d8 100%);
      padding: 1.25rem;
      overflow-y: auto;
      border-right: 1px solid #d4c9b8;
    }
    aside.right {
      border-right: none;
      border-left: 1px solid #d4c9b8;
    }
    main.content {
      flex: 1;
      overflow-y: auto;
      padding: 2.5rem;
      background: #fdfcfa;
    }
    .inner-content {
      max-width: 65ch;
      margin: 0 auto;
      line-height: 1.8;
    }
    .toc h2, .right h2 { 
      margin-top: 0;
      color: #3d3425;
      font-size: 1.1rem;
      border-bottom: 2px solid #c9a227;
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
    }
    .book-toggle {
      cursor: pointer;
      font-weight: 600;
      margin-top: 0.75rem;
      padding: 0.5rem 0.75rem;
      background: rgba(201, 162, 39, 0.1);
      border-radius: 4px;
      user-select: none;
      color: #3d3425;
      transition: all 0.2s;
    }
    .book-toggle:hover {
      background: rgba(201, 162, 39, 0.25);
    }
    .chapter-list {
      margin-left: 0.5rem;
      padding-left: 0.75rem;
      border-left: 2px solid #d4c9b8;
      display: none;
    }
    .chapter-list.open {
      display: block;
    }
    .chapter-link {
      display: block;
      text-decoration: none;
      color: #5a4d3a;
      padding: 0.35rem 0.5rem;
      margin: 0.15rem 0;
      border-radius: 3px;
      transition: all 0.15s;
    }
    .chapter-link:hover {
      background: rgba(201, 162, 39, 0.15);
      color: #2c2416;
    }
    .chapter {
      margin-bottom: 2.5rem;
    }
    .chapter h2 {
      color: #3d3425;
      border-bottom: 1px solid #d4c9b8;
      padding-bottom: 0.5rem;
    }
    .chapter p {
      margin-bottom: 1.2em;
      line-height: 1.85;
      text-align: justify;
    }
    .chapter p strong {
      display: inline-block;
      width: 2.5ch;
      color: #8b7355;
      font-weight: normal;
    }
    .right ul {
      list-style: none;
      padding: 0;
      margin: 1rem 0;
    }
    .right li {
      margin: 0.5rem 0;
    }
    .right a {
      color: #5a4d3a;
      text-decoration: none;
      transition: color 0.15s;
    }
    .right a:hover {
      color: #c9a227;
    }
    .right p {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #5a4d3a;
    }
    #theme-toggle button {
      background: #1a1a2e;
      color: #c9a227;
      border: 2px solid #c9a227;
      padding: 0.6rem 1rem;
      border-radius: 8px;
      font-size: 1.25rem;
    }
    #theme-menu {
      background: #1a1a2e !important;
      border: 1px solid #c9a227;
      border-radius: 8px;
    }
    #theme-menu button {
      background: #2a2a4e;
      color: #f0e6d3;
      border: 1px solid #c9a227;
      border-radius: 6px;
      padding: 0.5rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    #theme-menu button:hover {
      background: #3a3a5e;
    }
  </style>
  <link rel="stylesheet" href="/css/themes.css">
</head>
<body>
  <div class="layout">
    <header>
      <div class="header-content">
        <div style="width:150px;"></div>
        <div class="header-main">
          <h1 style="margin:0;">All Faiths On Fire - A Ministry of Good Works</h1>
          <div><em><%= quote.quote %></em></div>
        </div>
        <div class="header-auth">
          <% if (user) { %>
            <div class="user-info">
              <% if (user.profileImage) { %>
                <img src="<%= user.profileImage %>" alt="" class="user-avatar">
              <% } %>
              <span class="user-name"><%= user.firstName || user.email || 'Seeker' %></span>
            </div>
            <a href="/api/logout" class="auth-btn">Sign Out</a>
          <% } else { %>
            <a href="/api/login" class="auth-btn">Sign In</a>
            <a href="https://discord.gg/4kypdCMsC5" target="_blank" class="auth-btn" style="background:#5865F2;color:#fff;">Join Discord</a>
          <% } %>
        </div>
      </div>
    </header>
    <div class="main">
      <nav class="toc">
        <h2>Table of Contents</h2>


        <% books.forEach(book => { %>
          <div class="book-wrapper">
            <div class="book-toggle" data-target="book-<%= book.id %>">
              <%= book.title %>
            </div>
            <div class="chapter-list" id="book-<%= book.id %>">
              <% book.chapters.forEach(ch => { %>
                <a href="/?chapter=<%= ch.filename %>" class="chapter-link"><%= ch.title %></a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      
    <div style="margin-top:2rem;text-align:center;">
      <button onclick="goChapter('prev')">←</button>
      <button onclick="goChapter('next')">→</button>
    </div>
  </nav>
      <main class="content">
        <div class="inner-content">
          <% if (chapter) { %>
            <div class="chapter">
              <h2><%= chapter.title %></h2>
              <% verses.forEach(v => { %>
                <p><strong><%= v.verse_number %></strong> <%= v.text %></p>
              <% }) %>
            </div>
          <% } else { %>
            <p style="text-align:center;">Select a chapter from the Table of Contents to begin.</p>
          <% } %>
        </div>
      </main>
      <aside class="right">
        <h2>Mission</h2>
        <p>To awaken the dreamers, the burden-bearers, and the kind. To write the Book as it should have been written. Together.</p>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/creed">Creed</a></li>
          <li><a href="https://discord.gg/4kypdCMsC5" target="_blank" style="font-weight:bold;">Join Us on Discord</a></li>
          <li><a href="/submit">Contribute</a></li>
          <li><a href="https://gofundme.com/allfaithsonfire" target="_blank">GoFundMe</a></li>
        </ul>
      </aside>
    </div>
    <footer>
      &copy; All Faiths On Fire - <%= new Date().getFullYear() %>
    </footer>
  </div>
<div id="theme-toggle" style="position:fixed;bottom:20px;right:20px;z-index:1000;">
  <button style="font-size: 1.5rem; padding: 0.6rem 1rem;" onclick="toggleThemeMenu()">☼</button>
  <div id="theme-menu" style="display:none;position:absolute;bottom:50px;right:0;background:#222;color:#fff;padding:0.75rem;border-radius:0.5rem;width:180px;">
    <button onclick="setTheme('light')" style="width:100%;margin-bottom:4px;">☀️ Light</button>
    <button onclick="setTheme('dark')" style="width:100%;margin-bottom:4px;">🌑 Dark</button>
    <button onclick="setTheme('warm')" style="width:100%;margin-bottom:4px;">🔥 Warm</button>
    <button onclick="setTheme('cool')" style="width:100%;">❄️ Cool</button>
    <div style="margin-top:8px;">
      <label><input type="checkbox" id="twoColToggle" onchange="toggleColumns()"> 2 Columns</label>
    </div>
  </div>
</div>
<script>
function toggleThemeMenu() {
  const menu = document.getElementById('theme-menu');
  menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
}
function setTheme(name) {
  document.body.className = name;
  document.cookie = "theme=" + name + "; path=/";
}
function toggleColumns() {
  const main = document.querySelector('.inner-content');
  const twoCol = document.getElementById('twoColToggle').checked;
  main.style.columnCount = twoCol ? 2 : 1;
  document.cookie = "twocol=" + (twoCol ? "yes" : "no") + "; path=/";
}
function getCookie(key) {
  const val = document.cookie.split('; ').find(row => row.startsWith(key + "="));
  return val ? val.split('=')[1] : null;
}
function openBookForChapter(filename) {
  const link = document.querySelector(`.chapter-link[href*="${filename}"]`);
  if (!link) return;
  const parent = link.closest('.chapter-list');
  if (parent) parent.classList.add('open');
}
async function loadContent(url, push = true) {
  try {
    const res = await fetch(url);
    if (!res.ok) return false;
    const html = await res.text();
    document.querySelector('.inner-content').innerHTML = html;
    if (push) history.pushState({ url }, '', url.includes('?') ? url : '?page=' + url.replace('/content/', ''));
    return true;
  } catch(e) {
    return false;
  }
}
async function loadChapter(filename, push = true) {
  const res = await fetch('/chapter/' + filename);
  const html = await res.text();
  document.querySelector('.inner-content').innerHTML = html;
  if (push) history.pushState({ chapter: filename }, '', '?chapter=' + filename);
  openBookForChapter(filename);
}
window.onpopstate = (e) => {
  const chap = e.state?.chapter;
  const url = e.state?.url;
  if (chap) loadChapter(chap, false);
  else if (url) loadContent(url, false);
};
window.onload = () => {
  const theme = getCookie("theme");
  if (theme) setTheme(theme);
  const col = getCookie("twocol");
  if (col === "yes") {
    document.getElementById('twoColToggle').checked = true;
    toggleColumns();
  }
  const chapterParam = new URLSearchParams(window.location.search).get("chapter");
  if (chapterParam) loadChapter(chapterParam, false);

  document.querySelector('.toc').addEventListener('click', e => {
    const toggle = e.target.closest('.book-toggle');
    if (toggle) {
      const targetId = toggle.dataset.target;
      const content = document.getElementById(targetId);
      if (content) {
        const wasOpen = content.classList.contains('open');
        document.querySelectorAll('.chapter-list.open').forEach(el => el.classList.remove('open'));
        if (!wasOpen) content.classList.add('open');
      }
      e.stopPropagation();
      return;
    }
    const link = e.target.closest('.chapter-link');
    if (link) {
      e.preventDefault();
      const filename = new URL(link.href).searchParams.get('chapter');
      if (filename) loadChapter(filename);
    }
  });

  document.querySelector('.right').addEventListener('click', e => {
    const link = e.target.closest('a');
    if (!link) return;
    const href = link.getAttribute('href');
    if (href.startsWith('http') || href.startsWith('/submit')) return;
    if (href === '/about' || href === '/creed') {
      e.preventDefault();
      loadContent('/content' + href);
    }
  });
};
function goChapter(direction) {
  const chapters = [...document.querySelectorAll('.chapter-link')];
  const current = window.location.href.split('chapter=')[1];
  let index = chapters.findIndex(link => link.href.includes(current));
  if (index === -1) index = 0;
  const next = direction === 'next' ? chapters[index + 1] : chapters[index - 1];
  if (next) {
    const filename = new URL(next.href).searchParams.get('chapter');
    if (filename) loadChapter(filename);
  }
}
</script>
</body>
</html>
